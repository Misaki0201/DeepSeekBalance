# DeepSeek 余额监控 - 服务器配置
# 复制此文件为 .env 并填入配置

# 必填: 你的 DeepSeek API Key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 可选: 客户端访问令牌（推荐设置，防止任意访问）
# 设置后，App 需要配置相同的 Token 才能访问
ACCESS_TOKEN=your-secret-access-token

# 可选: 余额查询缓存时间（秒），默认 60
CACHE_TTL=60

# 可选: 监听端口，默认 5000
PORT=5000

# 可选: 调试模式
DEBUG=false
